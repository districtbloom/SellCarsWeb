function D.grade(condition)
 local worst='Good';for _,g in condition do if D.grades[g]>D.grades[worst] then worst=g end end;return worst
end
function D.quote(car,depth)
 local q={jobs={},cost=0,seconds=0}
 for _,id in {'Body','RunningGear','Mechanical','Exterior'} do local b=D.base[id];local n=D.grades[car.condition[id]]
  if n>0 then table.insert(q.jobs,{id=id,name=b.name,cost=b.cost*n,seconds=b.seconds*n,done=false,started=false,progress=0})end
 end
 if depth=='Good' then table.insert(q.jobs,{id='Tune',name='Tune & finish',cost=220,seconds=8,done=false,started=false,progress=0})end
 for _,j in q.jobs do q.cost+=j.cost;q.seconds+=j.seconds end;return q
end
